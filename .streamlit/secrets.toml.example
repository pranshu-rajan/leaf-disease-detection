# Copy this file to .streamlit/secrets.toml and fill in your own values.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml is git-ignored — never commit real keys/URLs.

# Required for AI-generated advisory reports (PDF export depends on this too).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY = "your_groq_api_key_here"

# Optional: only needed if you're hosting model weights externally instead of
# committing them to the repo (see README > "Handling model weights").
# These must be direct-download URLs (e.g. Hugging Face Hub "resolve" links),
# not "blob" links or Google Drive share links.
# HYBRID_CKPT_URL = "https://huggingface.co/<user>/<repo>/resolve/main/hybrid_model.pth"
# YOLO_CKPT_URL   = "https://huggingface.co/<user>/<repo>/resolve/main/lesion_detector_best.pt"
# CLASS_NAMES_URL = "https://huggingface.co/<user>/<repo>/resolve/main/class_names.json"